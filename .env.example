# Copy this file to .env.local and provide your own values.
DATABASE_URL=
# Optional direct URL for running the migration if your provider gives separate pooled/direct URLs.
DIRECT_DATABASE_URL=
ADMIN_EMAIL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 storage for magazine PDFs, covers and reader pages.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AI summaries ("The issue in brief"), generated once per issue and stored in the database.
# Gemini reads the PDF itself; Groq is the fallback and summarizes the extracted text.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides.
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=openai/gpt-oss-120b
# Characters of extracted text sent to Groq. The default (16000) fits the free tier; raise it on a paid plan.
GROQ_MAX_CHARS=16000
